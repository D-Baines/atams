        <mxCell id="G040LlnLVY9H00bqzc2F-69" value="If all the same, go through memory map variables and copy in NVM data using external write" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1089.5" y="724" width="217" height="60" as="geometry" />
        </mxCell>
        <mxCell id="G040LlnLVY9H00bqzc2F-70" value="&lt;div style=&quot;&quot;&gt;NVMHeader_t nvmHeader;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;span style=&quot;&quot;&gt;if (Platform::getFromNVM(0, sizeof(nvmHeader), NVMHeader)) != Atams::ERROR_NONE)&lt;/span&gt;&lt;div style=&quot;&quot;&gt;{&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; return (Atams::ERROR_PLATFORM);&lt;/div&gt;&lt;div style=&quot;&quot;&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;textDirection=ltr;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="1629" y="44" width="600" height="140" as="geometry" />
        </mxCell>
        <mxCell id="G040LlnLVY9H00bqzc2F-72" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;uint32_t nvmIndex = sizeof(NVMHeader_t);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;CRC::resetRecursive();&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;for (bytesInNVM)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; uint8_t byte;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; if (Platform::getFromNVM(nvmIndex, sizeof(byte), byte) != Atams::ERROR_NONE)&lt;/div&gt;&lt;div&gt;&amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; return (ERROR_PLATFORM);&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; CRC32::addToRecursive();&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;return (CRC32::calculateRecursive());&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;align=left;" parent="1" vertex="1">
          <mxGeometry x="1629" y="197" width="600" height="273" as="geometry" />
        </mxCell>
        <mxCell id="G040LlnLVY9H00bqzc2F-74" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;if (nvmHeader.checksum != calculateNVMChecksum(nvmHeader)) return (Atams::ERROR_NVM_CHECKSUM)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=19;align=left;" parent="1" vertex="1">
          <mxGeometry x="1629" y="484" width="600" height="23" as="geometry" />
        </mxCell>
        <mxCell id="G040LlnLVY9H00bqzc2F-76" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;uint32_t nvmIndex = sizeof(NVMHeader_t);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;for (blocksAfterUniversal in dataBlocks)&lt;/div&gt;&lt;div&gt;{&lt;/div&gt;&lt;div&gt;&amp;nbsp; for (varID in blockVars)&lt;/div&gt;&lt;div&gt;&amp;nbsp; {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; varLength = block.getVarLength(varID);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; bytes[varLength];&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Platform::getFromNVM(nvmIndex, varLength, bytes);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; block.externalTransfer(write, varID, bytes, length);&lt;/div&gt;&lt;div&gt;&amp;nbsp; }&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Correct error handling required&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;align=left;" parent="1" vertex="1">
          <mxGeometry x="1623" y="710" width="600" height="264" as="geometry" />
        </mxCell>
        <mxCell id="G040LlnLVY9H00bqzc2F-81" value="&lt;div style=&quot;&quot;&gt;GenInfo_t nvmGenInfo;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;span style=&quot;&quot;&gt;if (Platform::getFromNVM(sizeof(NVMHeader_t), sizeof(GenInfo_t), nvmGenInfo)) != Atams::ERROR_NONE)&lt;/span&gt;&lt;div style=&quot;&quot;&gt;{&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; return (Atams::ERROR_PLATFORM);&lt;/div&gt;&lt;div style=&quot;&quot;&gt;}&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;if (nvmGenInfo != _memoryMap.genInfo)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;{&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; return (Atams::ERROR_NVM_GEN_INFO);&lt;/div&gt;&lt;div style=&quot;&quot;&gt;}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;textDirection=ltr;arcSize=4;" parent="1" vertex="1">
          <mxGeometry x="1629" y="522.5" width="600" height="173" as="geometry" />
