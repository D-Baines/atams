        <mxCell id="G040LlnLVY9H00bqzc2F-27" value="&lt;b&gt;State: START&lt;/b&gt;&lt;br&gt;&lt;br&gt;setRequestPattern to read until ack for all genInfo variables.&lt;br&gt;&lt;br&gt;nextState = INIT_STATE_VALIDITY_CHECKS&lt;div&gt;state = INIT_STATE_BUS_UPDATE&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=13;" parent="1" vertex="1">
