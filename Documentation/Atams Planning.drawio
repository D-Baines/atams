        <mxCell id="G040LlnLVY9H00bqzc2F-28" value="&lt;b&gt;State: MAP VALIDITY CHECKS&lt;/b&gt;&lt;br&gt;&lt;br&gt;readIfNew on all genInfo variables.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;If error -&amp;nbsp;&lt;div&gt;State = INIT_STATE_START&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;else&lt;br&gt;nextState = INIT_STATE_ASSIGN_IDS&lt;br&gt;state = INIT_STATE_BUS_UPDATE&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;" parent="1" vertex="1">
